// Base resource configuration for Beacon v2 data loading pipeline
// Resource labels map to process directives via withLabel selectors

process {
    // Default error strategy: retry on OOM/timeout signals, max 3 attempts
    errorStrategy = { task.exitStatus in [137, 143, 255] ? 'retry' : 'finish' }
    maxRetries    = 3

    // Shell settings
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: 'small' {
        cpus   = { check_max(1,                    'cpus') }
        memory = { check_max(2.GB * task.attempt,  'memory') }
        time   = { check_max(1.h * task.attempt,   'time') }
    }

    withLabel: 'medium' {
        cpus   = { check_max(2,                    'cpus') }
        memory = { check_max(8.GB * task.attempt,  'memory') }
        time   = { check_max(4.h * task.attempt,   'time') }
    }

    withLabel: 'bigmem' {
        cpus   = { check_max(4,                     'cpus') }
        memory = { check_max(32.GB * task.attempt,  'memory') }
        time   = { check_max(12.h * task.attempt,   'time') }
    }

    withLabel: 'local_only' {
        cpus      = 1
        memory    = 4.GB
        time      = 2.h
        // On ILIFU, this label forces executor = 'local' via beacon.config
        // so import processes run on the head job (where the SSH tunnel lives)
    }
}
