// Test profile configuration
// Uses fixture data, skips MongoDB import, minimal resources

params {
    dataset_name = 'test_dataset'
    vcf_file     = "${projectDir}/test_data/sample.vcf"
    assembly     = 'GRCh38'
    outdir       = "${projectDir}/test_output"

    // Skip import — tests should never touch real MongoDB
    skip_import        = true
    strict_validation  = false
    verbose            = true
}

process {
    withLabel: 'small' {
        cpus   = 1
        memory = 512.MB
        time   = 10.min
    }
    withLabel: 'medium' {
        cpus   = 1
        memory = 1.GB
        time   = 15.min
    }
    withLabel: 'bigmem' {
        cpus   = 1
        memory = 1.GB
        time   = 15.min
    }
    withLabel: 'local_only' {
        cpus   = 1
        memory = 512.MB
        time   = 10.min
    }
}
