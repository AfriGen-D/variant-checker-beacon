# GA4GH Beacon v2 API - Environment Template
# Copy to .env.production and fill in real values before deploying.
# DO NOT commit .env.production to git.

# Django
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=beacon2.h3abionet.org,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=beacon_project.settings_boolean

# Security
SECURE_SSL_REDIRECT=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_NAME=beacon_db
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TIMEOUT=300

# Authentication (Boolean mode = disabled)
FEATURE_AUTHENTICATION_ENABLED=False
JWT_SECRET_KEY=CHANGE_ME
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Rate Limiting
FEATURE_RATE_LIMITING_ENABLED=True
RATELIMIT_DEFAULT=100/hour
RATELIMIT_QUERY_ENDPOINT=50/hour

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://beacon2.h3abionet.org
CORS_ALLOW_CREDENTIALS=False

# Pagination
API_PAGE_SIZE=100

# Beacon Identity
BEACON_API_NAME=GA4GH Beacon v2 - AfriGEND
BEACON_API_VERSION=2.0.0-boolean
BEACON_API_ID=org.afrigend.beacon
BEACON_ORGANIZATION_ID=afrigend
BEACON_ORGANIZATION_NAME=AfriGEND

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Features
METRICS_ENABLED=True
HEALTH_CHECK_ENABLED=True
BEACON_RESPONSE_MODE=BOOLEAN
BEACON_HIDE_DETAILED_DATA=True
