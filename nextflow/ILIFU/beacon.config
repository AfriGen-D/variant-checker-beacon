// ──────────────────────────────────────────────────────────────────────────────
// ILIFU cluster configuration for Beacon v2 data loading
// Usage: nextflow run main.nf -profile singularity,slurm -c ILIFU/beacon.config
// ──────────────────────────────────────────────────────────────────────────────

params {
    // ILIFU paths
    outdir     = '/cbio/users/mamana/beacon_output'
    max_cpus   = 32
    max_memory = '240.GB'
    max_time   = '7.d'

    // MongoDB via SSH tunnel (beacon.sh creates tunnel on port 27018)
    mongo_uri    = 'mongodb://localhost:27018/'
    mongo_db     = 'beacon_db'
    skip_import  = false

    // Redis flush via SSH to beacon server
    beacon_host = 'H3ABN-Beacon_beacon2.h3abionet.org-ilifu'
}

// -- Singularity --
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/cbio/users/mamana/.singularity/cache'
    runOptions = '--bind /cbio/users/mamana --bind /cbio/dbs'
}

// -- SLURM executor --
process {
    executor    = 'slurm'
    queue       = 'Main'
    queueSize   = 20
    clusterOptions = '--mail-type=END,FAIL --mail-user=${USER}@gmail.com'

    // Import processes must run locally (SSH tunnel only on head node)
    withLabel: 'local_only' {
        executor = 'local'
    }
}

// -- Work directory (scratch for intermediate files) --
workDir = '/scratch3/users/mamana/nextflow_work/beacon'
