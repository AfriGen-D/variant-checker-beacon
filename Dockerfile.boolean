# Production-ready Dockerfile for Boolean-only Beacon API
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=beacon_project.settings_boolean

WORKDIR /app

# Install system dependencies (--no-install-recommends reduces image size)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy project
COPY beacon_api/ beacon_api/
COPY beacon_project/ beacon_project/
COPY manage.py .
COPY requirements.txt .

# Create non-root user
RUN useradd --create-home --no-log-init --shell /usr/sbin/nologin beacon

# Create necessary directories and set ownership
RUN mkdir -p logs staticfiles && chown -R beacon:beacon /app

# Stamped by CI from the git tag being built; read by beacon_api/release.py and
# reported as `release` on /api/health. Declared HERE, not near the top: above
# the pip layer it would invalidate the dependency cache on every release.
ARG BEACON_RELEASE=""
ENV BEACON_RELEASE=${BEACON_RELEASE}

# Collect static files
RUN python manage.py collectstatic --noinput --settings=beacon_project.settings_boolean || true

USER beacon

EXPOSE 8000

# Health check (longer start-period for gunicorn boot)
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Gunicorn: 3 workers, 120s timeout for slow genomic queries
CMD ["gunicorn", "beacon_project.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
